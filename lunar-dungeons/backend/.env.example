# Use the same HS256 signing secret as Lunar's auth service.
JWT_SECRET=replace-with-the-existing-lunar-jwt-secret-at-least-32-chars
# Set this if Lunar includes an aud claim in its JWT.
# JWT_AUDIENCE=lunar

# If Lunar stores its JWT in a cookie, set the exact cookie name here.
DUNGEON_SESSION_COOKIE=lunar_session

# SQLite file is created automatically.
DATABASE_URL=sqlite://dungeons.db?mode=rwc
BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=info
